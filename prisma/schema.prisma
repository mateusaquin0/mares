// MARES — Schema Prisma
// Modelo de dados conforme docs/BANCO_DE_DADOS.md e docs/PROJETO_COMPLETO.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum MembershipRole {
  ORG_ADMIN
  RESEARCHER
}

enum UserStatus {
  INVITED
  ACTIVE
  DELETION_REQUESTED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Result {
  POSITIVO
  NEGATIVO
  INCONCLUSIVO
}

enum SampleStatus {
  STORED // em estoque
  IN_USE // em análise no momento
  DEPLETED // totalmente consumida
  DEGRADED // degradada / inutilizável
}

enum ResearchProtocolStatus {
  ACTIVE // combinação em uso: aceita novos lançamentos de análise
  INACTIVE // preservada para histórico, mas bloqueia novos lançamentos
}

enum FeedbackType {
  SUGGESTION // sugestão de melhoria
  BUG // relato de problema
}

enum FeedbackStatus {
  NEW // recém-recebido
  IN_REVIEW // em análise pelo admin
  RESOLVED // resolvido/atendido
  WONT_FIX // descartado
}

// Tipo do item pedido numa solicitação de glossário (espelha CatalogType, sem hífen).
enum CatalogRequestType {
  ORGAN
  PATHOGEN
  EXAM_TYPE
}

enum CatalogRequestStatus {
  PENDING // aguardando curadoria
  APPROVED // aprovada → item criado
  REJECTED // recusada (duplicata, inválida etc.)
}

// ─────────────────────────────────────────────────────────────
// Organização e usuários
// ─────────────────────────────────────────────────────────────

model Organization {
  id          String       @id @default(uuid())
  name        String
  // Localização (opcional) — usada em relatórios geográficos e no mapa de encalhes.
  city        String?
  state       String? // UF / província
  country     String?
  // Desativação: um grupo que fica SEM membros é desativado (deactivatedAt = data), não
  // excluído. Seus dados públicos continuam visíveis no mapa público (que filtra só por
  // isPublic). Readicionar um membro reativa (deactivatedAt = null). Ver docs/CADASTRO_E_ACESSO.md.
  deactivatedAt DateTime?
  memberships Membership[]
  researches  Research[]
  createdAt   DateTime     @default(now())
}

model User {
  // id corresponde ao id do usuário no Supabase Auth (auth.users.id)
  id            String       @id
  email         String       @unique
  name          String?
  isSystemAdmin Boolean      @default(false)
  status        UserStatus   @default(INVITED)
  // Aceite dos Termos de Uso (registrado ao solicitar acesso e ao aceitar convite).
  termsVersion    String?
  termsAcceptedAt DateTime?
  memberships   Membership[]
  researchesCreated Research[] @relation("ResearchCreator")
  // Pesquisas às quais o usuário está vinculado como pesquisador (escopo de visibilidade).
  researchMemberships ResearchMember[]
  feedbacks     Feedback[]   @relation("FeedbackAuthor")
  catalogRequests CatalogRequest[] @relation("CatalogRequestAuthor")
  createdAt     DateTime     @default(now())
}

// Vínculo N:N entre usuário e organização, com o papel do usuário naquela org.
model Membership {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId        String
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         MembershipRole @default(RESEARCHER)
  createdAt    DateTime       @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

// Solicitação de acesso de um novo admin de organização (aprovada pelo admin global).
model JoinRequest {
  id               String            @id @default(uuid())
  email            String
  requesterName    String
  organizationName String
  status           JoinRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Pesquisas e protocolos
// ─────────────────────────────────────────────────────────────

model Research {
  id           String             @id @default(uuid())
  name         String
  description  String?
  isPublic     Boolean            @default(false)
  orgId        String
  organization Organization       @relation(fields: [orgId], references: [id])
  // Autor (para a regra "pesquisador edita a própria criação"); SetNull se o usuário for removido.
  createdById  String?
  createdBy    User?              @relation("ResearchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Pesquisadores vinculados a esta pesquisa (escopo de visibilidade). O criador e o admin
  // da org têm acesso independentemente do vínculo (ver docs/PERMISSOES.md).
  members      ResearchMember[]
  protocols    ResearchProtocol[]
  animals      Animal[]
  // Indivíduos compartilhados de outra pesquisa que esta também estuda (ver AnimalResearch).
  animalLinks  AnimalResearch[]
  // Amostras coletadas por esta pesquisa (o indivíduo pode ter amostras de várias pesquisas).
  samples      Sample[]
  createdAt    DateTime           @default(now())

  @@index([orgId])
  @@index([createdById])
}

// Vínculo N:N entre pesquisador e pesquisa: define o ESCOPO DE VISIBILIDADE do pesquisador.
// Um RESEARCHER só vê os dados das pesquisas às quais está vinculado (ou que criou); o
// ORG_ADMIN vê todas as pesquisas da org. Ver docs/PERMISSOES.md §Escopo por pesquisa.
model ResearchMember {
  researchId String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([researchId, userId])
  @@index([userId])
}

// Define quais exames/patógenos/órgãos compõem uma pesquisa.
// Estado (ver docs/PLANO_PROTOCOLO_ANALISES.md): ACTIVE aceita novos lançamentos; INACTIVE
// preserva o histórico de análises, mas bloqueia novos cadastros/edições para a combinação.
model ResearchProtocol {
  id            String                 @id @default(uuid())
  researchId    String
  research      Research               @relation(fields: [researchId], references: [id], onDelete: Cascade)
  organId       String
  organ         Organ                  @relation(fields: [organId], references: [id])
  pathogenId    String
  pathogen      Pathogen               @relation(fields: [pathogenId], references: [id])
  examTypeId    String
  examType      ExamType               @relation(fields: [examTypeId], references: [id])
  status        ResearchProtocolStatus @default(ACTIVE)
  deactivatedAt DateTime?

  @@unique([researchId, organId, pathogenId, examTypeId])
  @@index([researchId])
  @@index([researchId, status])
}

// ─────────────────────────────────────────────────────────────
// Catálogos globais (reutilizáveis entre pesquisas)
// ─────────────────────────────────────────────────────────────

// Catálogos: `key` é um slug estável (identidade, independente do idioma).
// Rótulos traduzíveis usam JSON `{ "pt": ..., "en": ... }` — um campo por rótulo, extensível a
// novos idiomas sem migration. Patógeno é nome científico (latim, universal) → `name` texto
// simples; só o `group` é traduzível. Ver docs/I18N.md §catálogos.
model Organ {
  id          String             @id @default(uuid())
  key         String             @unique // ex: "encefalo"
  name        Json // { pt: "Encéfalo", en: "Brain" }
  // Autor do item; o criador edita/exclui enquanto não usado (ver docs/PERMISSOES.md).
  createdById String?            @map("created_by_id")
  protocols   ResearchProtocol[]
  samples     Sample[]

  @@index([createdById])
}

// Grupo de patógeno (vocabulário controlado): bactérias, fungos, protozoários, vírus,
// helmintos, ações antrópicas. `usesScientificName` decide se o item usa nome científico
// (latim, universal) ou nome comum traduzível. Ver docs/I18N.md §catálogos.
model PathogenGroup {
  id                 String     @id @default(uuid())
  key                String     @unique // ex: "bacteria", "anthropogenic"
  name               Json // { pt, en }
  usesScientificName Boolean    @default(true) @map("uses_scientific_name")
  pathogens          Pathogen[]
}

model Pathogen {
  id             String             @id @default(uuid())
  key            String             @unique // ex: "toxoplasma_gondii"
  groupId        String             @map("group_id")
  group          PathogenGroup      @relation(fields: [groupId], references: [id])
  // Grupos científicos: scientificName preenchido (name nulo). Grupos comuns (ações
  // antrópicas): name { pt, en } preenchido (scientificName nulo). Exibição:
  // scientificName ?? name[locale].
  scientificName String?            @map("scientific_name")
  name           Json?
  // Táxon (NCBI Taxonomy) — preenchido pelo autocomplete do nome científico. taxonId = TaxId.
  // taxonRank = rank NCBI do próprio patógeno ("species", "genus", "family"…); decide se é um
  // alvo AMPLO (rastreio) elegível a confirmação de espécie. Ver docs/PLANO_CONFIRMACAO_SEQUENCIAMENTO.md.
  taxonFamily    String?            @map("taxon_family")
  taxonOrder     String?            @map("taxon_order")
  taxonRank      String?            @map("taxon_rank")
  taxonId        Int?               @map("taxon_id")
  createdById    String?            @map("created_by_id")
  protocols      ResearchProtocol[]
  analyses       Analysis[]

  @@index([groupId])
  @@index([createdById])
}

model ExamType {
  id          String             @id @default(uuid())
  key         String             @unique // ex: "npcr"
  name        Json // { pt: "nPCR", en: "nested PCR (nPCR)" }
  // Medida quantitativa opcional do exame (ex.: Ct no qPCR, Título nas serologias, OD no
  // ELISA). measureLabel ausente = exame só qualitativo (sem valor). measureUnit é uma
  // anotação curta opcional (ex.: "ciclos"). Ver docs/BANCO_DE_DADOS.md.
  measureLabel Json? // { pt, en } — rótulo da coluna de valor na grade de análises
  measureUnit  String? // unidade/anotação curta opcional
  createdById String?            @map("created_by_id")
  protocols   ResearchProtocol[]
  analyses    Analysis[]

  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────
// Animais, amostras e análises
// ─────────────────────────────────────────────────────────────

model Animal {
  id                 String        @id @default(uuid())
  controlId          String? // ID de controle interno, único por organização (ver @@unique abaixo)
  simbaRecordNumber  String? // Identificador SIMBA, único por organização (ver @@unique abaixo)
  species            String? // NULL = espécie indeterminada (carcaça não identificável)
  // Campos preenchidos via WoRMS após validação taxonômica
  wormsAphiaId       Int?
  taxonFamily        String?
  taxonOrder         String?
  sex                String?
  lifeStage          String?
  // Necrópsia — condição da carcaça / escore corporal / condição da morte.
  // Preenchidos manualmente: a API pública do SIMBA não os exporta (só a data de
  // necrópsia em measurementDeterminedDate e as observações em occurrenceRemarks).
  bodyCondition      String? // "Condição da carcaça" (ex.: código 1-5)
  decompositionStage String? // "Escore corporal"
  deathCondition     String? // "Condição da morte" (ex.: Natural)
  necropsyDate       DateTime?
  // lat/lon como Float; em produção, considerar PostGIS geography
  strandingLat       Float?
  strandingLon       Float?
  strandingBeach     String?
  municipality       String?
  state              String?
  eventDate          DateTime?
  macroscopicNotes   String? // "Exame externo" (occurrenceRemarks no SIMBA)
  source             String        @default("manual")
  isPublic           Boolean       @default(false)
  researchId         String
  research           Research      @relation(fields: [researchId], references: [id])
  // Organização dona, denormalizada de research, para o controlId ser único POR ORG.
  // Definida na criação; a pesquisa (e portanto a org) do animal não muda depois.
  orgId              String
  samples            Sample[]
  media              AnimalMedia[]
  // Pesquisas ADICIONAIS que também estudam este indivíduo (mesma org). A pesquisa
  // primária/criadora é `researchId`; o conjunto efetivo = {researchId} ∪ participations.
  participations     AnimalResearch[]
  createdAt          DateTime      @default(now())

  @@unique([orgId, controlId])
  @@unique([orgId, simbaRecordNumber])
  @@index([researchId])
  @@index([species])
}

// Participação de uma pesquisa em um indivíduo (Animal).
//
// O Animal representa o indivíduo FÍSICO (identidade compartilhada: SIMBA, espécie,
// coordenadas, encalhe/necrópsia). Cada pesquisa que o estuda mantém suas próprias amostras
// e análises. A pesquisa primária/criadora é `Animal.researchId`; esta tabela registra as
// pesquisas ADICIONAIS (do MESMO grupo) que compartilham o indivíduo, sem duplicar a
// identidade. Conjunto efetivo de pesquisas de um animal = {researchId} ∪ participations.
model AnimalResearch {
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  researchId String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([animalId, researchId])
  @@index([researchId])
}

// Amostra física coletada durante a necrópsia
model Sample {
  id              String       @id @default(uuid())
  animalId        String
  animal          Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  // Pesquisa dona da amostra: UMA das pesquisas do indivíduo (primária ou participante).
  // Escopa a grade de análises e os exports POR PESQUISA (indivíduo compartilhado — Etapa 2).
  researchId      String
  research        Research     @relation(fields: [researchId], references: [id])
  organId         String
  organ           Organ        @relation(fields: [organId], references: [id])
  // Organização dona, denormalizada de animal→pesquisa, para a unicidade da identificação
  // ser POR ORGANIZAÇÃO (não global). Definida na criação; o animal nunca muda de org.
  orgId           String
  identification  String // identificação/código da amostra, obrigatória e única por organização (ex.: "AM-001")
  sampleType      String // "tecido fresco", "DNA extraído", "lâmina", "parafina", "soro"
  collectionDate  DateTime?
  storageLocation String? // ex: "Freezer A, caixa 3, posição B2"
  storageTemp     Float? // temperatura em °C: -80, -20, 4, 25
  status          SampleStatus @default(STORED)
  notes           String?
  analyses        Analysis[]
  createdAt       DateTime     @default(now())

  @@unique([orgId, identification])
  @@index([animalId])
  @@index([researchId])
}

model Analysis {
  id         String   @id @default(uuid())
  sampleId   String
  sample     Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  pathogenId String
  pathogen   Pathogen @relation(fields: [pathogenId], references: [id])
  examTypeId String
  examType   ExamType @relation(fields: [examTypeId], references: [id])
  result     Result? // NULL = ainda não testado
  // Valor quantitativo conforme ExamType.measureLabel (ex.: Ct no qPCR, título nas
  // serologias). NULL quando não aplicável ou não medido.
  measureValue Float? @map("ctValue")
  notes      String?
  // Confirmação de espécie (ver docs/PLANO_CONFIRMACAO_SEQUENCIAMENTO.md):
  // NULL = análise de RASTREIO (aparece na grade, definida pelo protocolo). Preenchido = análise
  // de CONFIRMAÇÃO (sequenciamento) pendurada num rastreio POSITIVO; carrega a espécie resolvida
  // (pathogenId) e não exige entrada de ResearchProtocol. Cascade: apagar o rastreio apaga suas
  // confirmações (importante: deleteProtocolCascade mira o rastreio; os filhos caem por aqui).
  parentAnalysisId String?    @map("parent_analysis_id")
  parentAnalysis   Analysis?  @relation("AnalysisConfirmation", fields: [parentAnalysisId], references: [id], onDelete: Cascade)
  confirmations    Analysis[] @relation("AnalysisConfirmation")
  sequences        SequenceRecord[]
  createdAt  DateTime @default(now())

  @@unique([sampleId, pathogenId, examTypeId])
  @@index([sampleId])
  @@index([parentAnalysisId])
}

// Rastro de um sequenciamento que sustenta a determinação de espécie de uma Analysis de
// confirmação (parentAnalysisId preenchido). 1:N — uma mesma espécie pode ter mais de uma
// sequência (ex.: marcadores 18S e cox1). A espécie NÃO vive aqui (é o pathogenId da análise);
// estes campos guardam o COMO se chegou à espécie. Ver docs/PLANO_CONFIRMACAO_SEQUENCIAMENTO.md.
model SequenceRecord {
  id          String   @id @default(uuid())
  analysisId  String   @map("analysis_id")
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  marker      String? // gene/região: "18S rRNA", "ITS1", "cox1 (COI)" — DwC target_gene
  accession   String? // nº de acesso GenBank/BOLD (match de referência e/ou depósito próprio)
  pctIdentity Float?   @map("pct_identity") // % de identidade do BLAST
  consensus   String? // sequência consenso (FASTA), opcional
  platform    String? // "Sanger", "Illumina", opcional
  createdAt   DateTime @default(now())

  @@index([analysisId])
}

// Arquivos anexados a um animal (fotos de campo, microscopia, laudos PDF)
model AnimalMedia {
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String // URL no Supabase Storage
  mimeType  String // "image/jpeg", "application/pdf" etc.
  label     String? // descrição livre
  createdAt DateTime @default(now())

  @@index([animalId])
}

// Rastreabilidade de alterações em dados científicos
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  entity    String // "Animal", "Analysis", "Sample"
  entityId  String
  field     String // campo alterado
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())

  @@index([entity, entityId])
}

// Sugestões e relatos de bug enviados por usuários autenticados; visíveis ao admin global.
model Feedback {
  id             String         @id @default(uuid())
  type           FeedbackType
  title          String // título curto (resumo)
  message        String
  pageUrl        String? // de onde o usuário enviou (contexto)
  status         FeedbackStatus @default(NEW)
  adminNote      String? // anotação do admin ao triar
  // Autor; SetNull para preservar o histórico se o usuário for removido.
  createdById    String?
  createdBy      User?          @relation("FeedbackAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByEmail String // snapshot do e-mail do autor
  orgId          String? // organização ativa no momento do envio (contexto)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Solicitação de inclusão de item no glossário global aberta por um pesquisador.
// Curadoria: qualquer admin de grupo OU admin global aprova/rejeita (fila única).
// `payload` guarda o corpo do formulário (validado por Zod na entrada e na aprovação);
// ao aprovar, o item é criado pela MESMA lógica da criação direta. Ver docs/GLOSSARIO_SOLICITACOES.md.
model CatalogRequest {
  id               String               @id @default(uuid())
  type             CatalogRequestType
  payload          Json // corpo do formulário: { namePt, nameEn, groupId, scientificName, taxon… }
  status           CatalogRequestStatus @default(PENDING)
  // Autor; SetNull para preservar o histórico se o usuário for removido.
  requestedById    String?
  requestedBy      User?                @relation("CatalogRequestAuthor", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByEmail String // snapshot do e-mail do solicitante
  orgId            String? // grupo ativo no momento da solicitação (contexto + anonimização por grupo)
  orgName          String? // snapshot do nome do grupo (rótulo, resiste a rename/desativação)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String? // motivo da rejeição (opcional)
  duplicateOfId    String? // item canônico quando rejeitada como duplicata
  createdItemId    String? // item gerado na aprovação (rastro; sem FK)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([requestedById])
}
