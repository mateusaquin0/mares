# ─────────────────────────────────────────────────────────────
# MARES — Exemplo de variáveis de ambiente (copie para .env)
# ─────────────────────────────────────────────────────────────

# Supabase — Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase — Auth e Storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"   # apenas server-side

# URL da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Identidade e acesso
ADMIN_EMAIL="admin@example.com"
SUPPORT_EMAIL="support@example.com"

# CountryStateCity — autocomplete de estado/cidade (apenas server-side; proxy em /api/geo)
# Gere uma chave gratuita em https://countrystatecity.in
CSC_API_KEY="your_csc_api_key"

# SIMBA (Petrobras) — importação de animais por número de registro (proxy /api/simba).
# URL com o placeholder {record}, substituído pelo número do registro no fetch.
# Por padrão usa o endpoint PÚBLICO (sem autenticação). Se o acesso exigir token,
# defina SIMBA_API_TOKEN (enviado como Bearer). Ver docs/PROJETO_COMPLETO.md §7.1.
SIMBA_API_URL="https://simba.petrobras.com.br/simba/web/api/ocorrencia/{record}/dwc"
# SIMBA_API_TOKEN=""
